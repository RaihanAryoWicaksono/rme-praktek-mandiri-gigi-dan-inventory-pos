@startuml Use Case Diagram — Dental Medical Inventory POS

!theme cerulean-outline
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam linetype ortho

skinparam actor {
    BackgroundColor #E8F5E9
    BorderColor #388E3C
    FontColor #1B5E20
    FontStyle bold
}

skinparam usecase {
    BackgroundColor #E3F2FD
    BorderColor #1565C0
    FontColor #0D47A1
    ArrowColor #1565C0
}

skinparam package {
    BackgroundColor #FAFAFA
    BorderColor #BDBDBD
    FontColor #424242
    FontStyle bold
}

' ─────────────────────────────────────────────────────────────
'  AKTOR
' ─────────────────────────────────────────────────────────────
actor "Pengunjung" as Guest
actor "Admin /\nStaf Klinik"  as Admin

' ─────────────────────────────────────────────────────────────
