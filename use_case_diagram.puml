' ─────────────────────────────────────────────────────────────

package "Halaman Publik" as PKG_PUBLIC {
    usecase "Lihat Landing Page"           as UC11
    usecase "Pantau Antrian\nReal-Time"    as UC12
    usecase "Aktifkan\nNotifikasi Suara"   as UC13
}

